@{
    var pageTitle = ViewData["Title"]?.ToString() ?? "Atlas Soft";

    var controller = ViewContext.RouteData.Values["controller"]?.ToString() ?? "";
    var action = ViewContext.RouteData.Values["action"]?.ToString() ?? "Index";

    var isHome = controller == "Home" && action == "Index";
    var isWms = controller == "Urunler" && action == "Wms";
    var isAi = controller == "Urunler" && action == "Ai";
    var isBusiness = controller == "Urunler" && action == "Business";

    var homeUrl = Url.Action("Index", "Home") ?? "/";
}


<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>@pageTitle</title>

    <meta name="description"
          content="Atlas Soft akıllı yazılım çözümleri. Antrepo yönetimi, stok takibi, muhasebe, yapay zekâ destekli beyanname okuma ve iş süreçleri için dijital çözümler." />

    <meta name="theme-color" content="#071c39" />

    <link rel="icon" type="image/svg+xml" href="~/favicon.svg" asp-append-version="true" />

    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/AtlasWeb.styles.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/StyleSheet.css" asp-append-version="true" />


    <style>
        :root {
            --atlas-navy: #071c39;
            --atlas-blue: #14529b;
            --atlas-accent: #2685ed;
        }

        body {
            font-family: 'Segoe UI', Arial, sans-serif;
            background: #ffffff;
            color: #172b4d;
            margin: 0;
        }

        .atlas-navbar {
            background: #ffffff;
            border-bottom: 1px solid #e8edf5;
            box-shadow: 0 3px 16px rgba(7, 28, 57, .05);
            padding: 13px 0;
        }

            .atlas-navbar .navbar-nav .nav-item {
                flex-shrink: 0;
            }

            .atlas-navbar .nav-link {
                white-space: nowrap;
            }

            .atlas-navbar .container {
                max-width: 1320px;
            }

        .atlas-brand {
            font-size: 30px;
            font-weight: 850;
            letter-spacing: 2px;
            color: var(--atlas-navy) !important;
            text-decoration: none;
            line-height: 1;
        }

            .atlas-brand span {
                color: var(--atlas-accent);
            }

            .atlas-brand .atlas-brand-sub {
                color: #64748b;
            }

        .atlas-brand-sub {
            display: block;
            font-size: 9px;
            letter-spacing: 1.3px;
            font-weight: 600;
            color: #64748b;
            margin-top: 5px;
        }

        .atlas-navbar .nav-link {
            font-size: 14px;
            font-weight: 600;
            color: #334155 !important;
            padding: 10px 12px !important;
            transition: color .2s;
        }

            .atlas-navbar .nav-link:hover,
            .atlas-navbar .nav-link:focus {
                color: var(--atlas-accent) !important;
            }

        .atlas-demo-button {
            background: var(--atlas-blue);
            color: #ffffff !important;
            padding: 11px 20px;
            border-radius: 9px;
            text-decoration: none;
            font-weight: 650;
            font-size: 14px;
            display: inline-block;
            transition: background .2s;
        }

            .atlas-demo-button:hover {
                background: #0b3972;
                color: #ffffff;
            }

        .atlas-main {
            min-height: 60vh;
        }

        .atlas-footer {
            background: var(--atlas-navy);
            color: #cbd5e1;
            padding: 55px 0 20px;
            margin-top: 50px;
        }

            .atlas-footer h4 {
                color: #ffffff;
                font-size: 17px;
                font-weight: 700;
                margin-bottom: 18px;
            }

            .atlas-footer p {
                color: #b8c7dc;
                line-height: 1.8;
                font-size: 14px;
            }

            .atlas-footer a {
                color: #cbd5e1;
                text-decoration: none;
                display: block;
                margin-bottom: 11px;
                font-size: 14px;
            }

                .atlas-footer a:hover {
                    color: #ffffff;
                }

        .atlas-footer-brand {
            font-size: 32px;
            font-weight: 850;
            color: white;
            letter-spacing: 2px;
            margin-bottom: 15px;
        }

        .atlas-footer-bottom {
            border-top: 1px solid rgba(255,255,255,.12);
            padding-top: 20px;
            margin-top: 35px;
            font-size: 13px;
            color: #a9bbd3;
        }

        /* Ürün sayfalarının hero bölümü */
        .atlas-wms-page .atlas-hero,
        .atlas-ai-page .atlas-hero {
            width: 100%;
            max-width: 100%;
            margin-left: 0;
            margin-right: 0;
            padding: 70px 32px;
            box-sizing: border-box;
            text-align: center;
            overflow: hidden;
        }

            .atlas-wms-page .atlas-hero h1,
            .atlas-ai-page .atlas-hero h1,
            .atlas-wms-page .atlas-hero h2,
            .atlas-ai-page .atlas-hero h2 {
                color: #fff !important;
            }

            .atlas-wms-page .atlas-hero p,
            .atlas-ai-page .atlas-hero p {
                color: #e2edff !important;
                max-width: 760px;
                margin: 18px auto 28px;
            }

            .atlas-wms-page .atlas-hero .atlas-btn,
            .atlas-ai-page .atlas-hero .atlas-btn {
                display: inline-block;
                margin: 6px;
            }

        /* Mobil menü düğmesini her arka planda görünür yap */
        .atlas-navbar .navbar-toggler {
            border: 1px solid #cbd5e1;
            border-radius: 9px;
            padding: 9px 11px;
            background-color: #f1f5f9;
            box-shadow: none;
        }

            .atlas-navbar .navbar-toggler:focus-visible {
                outline: 3px solid var(--atlas-accent);
                outline-offset: 2px;
            }

        @@media (max-width: 1199px) {
            .atlas-navbar .navbar-collapse {
                padding-top: 15px;
                width: 100%;
            }

            .atlas-navbar .nav-link {
                padding: 12px 5px !important;
            }

            .atlas-demo-button {
                margin-top: 10px;
                margin-bottom: 8px;
            }
        }

        @@media (max-width: 991px) {
            .atlas-navbar .navbar-collapse {
                padding-top: 15px;
                width: 100%;
            }

            .atlas-navbar .nav-link {
                padding: 12px 5px !important;
            }

            .atlas-demo-button {
                margin-top: 10px;
                margin-bottom: 8px;
            }
        }
    </style>
</head>

<body>

    <header>
        <nav class="navbar navbar-expand-xl navbar-light atlas-navbar">
            <div class="container">

                <a class="navbar-brand atlas-brand"
                   asp-controller="Home"
                   asp-action="Index"
                   aria-label="Atlas Soft Ana Sayfa">
                    ATLAS <span>SOFT</span>
                    <span class="atlas-brand-sub">
                        AKILLI YAZILIM ÇÖZÜMLERİ
                    </span>
                </a>

                <button class="navbar-toggler"
                        type="button"
                        data-bs-toggle="collapse"
                        data-bs-target="#atlasNavbar"
                        aria-controls="atlasNavbar"
                        aria-expanded="false"
                        aria-label="Menüyü aç veya kapat">
                    <span class="navbar-toggler-icon"></span>
                </button>

                <div class="collapse navbar-collapse" id="atlasNavbar">

                    <style>
                        @@media (max-width: 1199.98px) {
                            #atlasNavbar .navbar-nav .nav-item .nav-link,
                            #atlasNavbar .navbar-nav .nav-item .nav-link:link,
                            #atlasNavbar .navbar-nav .nav-item .nav-link:visited {
                                color: #17365b !important;
                                -webkit-text-fill-color: #17365b !important;
                                opacity: 1 !important;
                                text-shadow: none !important;
                            }

                                #atlasNavbar .navbar-nav .nav-item .nav-link.active {
                                    color: #1254a0 !important;
                                    -webkit-text-fill-color: #1254a0 !important;
                                    background-color: #dbeafe !important;
                                }
                        }
                    </style>

                    <ul class="navbar-nav ms-auto align-items-xl-center">


                        <li class="nav-item">
                            <a class="nav-link @(isHome ? "active" : "")"
                               aria-current="@(isHome ? "page" : null)"
                               href="@homeUrl">Ana Sayfa</a>
                        </li>

                        <li class="nav-item">
                            <a class="nav-link @(isWms ? "active" : "")"
                               aria-current="@(isWms ? "page" : null)"
                               asp-controller="Urunler"
                               asp-action="Wms">ATLAS WMS</a>
                        </li>

                        <li class="nav-item">
                            <a class="nav-link @(isAi ? "active" : "")"
                               aria-current="@(isAi ? "page" : null)"
                               asp-controller="Urunler"
                               asp-action="Ai">ATLAS AI</a>
                        </li>

                        <li class="nav-item">
                            <a class="nav-link @(isBusiness ? "active" : "")"
                               aria-current="@(isBusiness ? "page" : null)"
                               asp-controller="Urunler"
                               asp-action="Business">ATLAS Business</a>
                        </li>


                        <li class="nav-item ms-xl-3">
                            <a class="atlas-demo-button"
                               asp-controller="Demo"
                               asp-action="Index">
                                Demo Talep Et
                            </a>
                        </li>


                    </ul>
                </div>

            </div>
        </nav>
    </header>

    <div class="container atlas-main">
        <main role="main">
            @RenderBody()
        </main>
    </div>


    <footer class="atlas-footer atlas-footer-premium">
        <div class="container">

            <div class="row gy-5 atlas-footer-main">

                <div class="col-lg-5 col-md-6">
                    <div class="atlas-footer-logo">
                        ATLAS <span>SOFT</span>
                    </div>

                    <div class="atlas-footer-tagline">
                        AKILLI YAZILIM ÇÖZÜMLERİ
                    </div>

                    <p class="atlas-footer-description">
                        İşletmelerin operasyonlarını daha verimli,
                        daha kontrollü ve daha akıllı yönetmeleri
                        için modern yazılım çözümleri geliştiriyoruz.
                    </p>

                    <div class="atlas-footer-products">
                        <span>Depo Yönetimi</span>
                        <span>Yapay Zekâ</span>
                        <span>İş Yönetimi</span>
                    </div>
                </div>

                <div class="col-lg-2 col-md-6">
                    <h4>Yazılımlarımız</h4>

                    <a asp-controller="Urunler"
                       asp-action="Wms">ATLAS WMS</a>

                    <a asp-controller="Urunler"
                       asp-action="Ai">ATLAS AI</a>

                    <a asp-controller="Urunler"
                       asp-action="Business">ATLAS Business</a>
                </div>

                <div class="col-lg-2 col-md-6">
                    <h4>Hızlı Bağlantılar</h4>

                    <a asp-controller="Home"
                       asp-action="Index">Ana Sayfa</a>

                    <a href="@(homeUrl + "#ozellikler")">Özellikler</a>

                    <a href="@(homeUrl + "#fiyatlar")">Fiyatlandırma</a>

                    <a href="@(homeUrl + "#sss")">Sık Sorulan Sorular</a>
                </div>

                <div class="col-lg-3 col-md-6">
                    <h4>İletişim</h4>

                    <p>
                        İşletmenize uygun yazılım çözümlerini
                        birlikte değerlendirelim.
                    </p>

                    <a asp-controller="Demo"
                       asp-action="Index"
                       class="atlas-footer-cta">
                        Demo Talep Et →
                    </a>
                </div>

            </div>



        </div>


        <div style="text-align:center;
            padding:20px 10px 5px;
            border-top:1px solid rgba(255,255,255,0.12);
            margin-top:25px;">

            <div style="color:#cbd5e1; font-size:12px;">
                &copy; @DateTime.Now.Year ATLAS SOFT.
                All Rights Reserved.
            </div>

            <div style="color:#60a5fa;
                font-size:13px;
                font-weight:600;
                margin-top:8px;">
                Designed &amp; Developed by
                Fatih Sarmaşık &amp; Yavuzhan Sarmaşık
            </div>

        </div>


    </footer>

    <style>
        .atlas-footer-premium {
            background: linear-gradient(160deg, #07162d, #0b2546);
            color: #c1d1e5;
            padding: 75px 0 25px;
            margin-top: 0;
            border-top: 1px solid #21446d;
        }

            .atlas-footer-premium .atlas-footer-main {
                padding-bottom: 35px;
            }

            .atlas-footer-premium .atlas-footer-logo {
                font-size: 36px;
                font-weight: 900;
                letter-spacing: 2px;
                color: #fff;
            }

                .atlas-footer-premium .atlas-footer-logo span {
                    color: #60a5fa;
                }

            .atlas-footer-premium .atlas-footer-tagline {
                color: #8ba8ca;
                font-size: 11px;
                letter-spacing: 2px;
                margin: 7px 0 23px;
            }

            .atlas-footer-premium .atlas-footer-description {
                max-width: 420px;
                line-height: 1.9;
                font-size: 14px;
                color: #b8c9df;
            }

        .atlas-footer-products {
            display: flex;
            flex-wrap: wrap;
            gap: 9px;
            margin-top: 20px;
        }

            .atlas-footer-products span {
                border: 1px solid #31547e;
                border-radius: 30px;
                padding: 7px 12px;
                font-size: 11px;
                color: #a9d1ff;
                background: #112d50;
            }

        .atlas-footer-premium h4 {
            color: #fff;
            font-size: 16px;
            font-weight: 800;
            margin-bottom: 24px;
        }

        .atlas-footer-premium a:not(.atlas-footer-cta) {
            color: #c1d1e5;
            text-decoration: none;
            margin-bottom: 15px;
            font-size: 14px;
            transition: color .2s, transform .2s;
        }

            .atlas-footer-premium a:not(.atlas-footer-cta):hover {
                color: #60a5fa;
                transform: translateX(4px);
            }

        .atlas-footer-premium .atlas-footer-cta {
            display: inline-block;
            width: fit-content;
            padding: 13px 22px;
            background: #2685ed;
            color: #fff;
            border-radius: 10px;
            font-size: 13px;
            font-weight: 800;
            text-decoration: none;
            margin-top: 8px;
        }

            .atlas-footer-premium .atlas-footer-cta:hover {
                background: #176ac3;
                color: #fff;
            }

        .atlas-footer-premium .atlas-footer-bottom {
            border-top: 1px solid #274263;
            padding-top: 25px;
            margin-top: 15px;
            color: #91a8c4;
            font-size: 12px;
        }

        @@media (max-width: 767px) {
            .atlas-footer-premium {
                padding: 55px 0 25px;
            }

                .atlas-footer-premium .atlas-footer-logo {
                    font-size: 30px;
                }
        }
    </style>


    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    <script src="~/js/atlas.js" asp-append-version="true"></script>


    <!-- ATLAS SOFT Akıllı Satış Danışmanı -->
    <div id="atlasChat" class="atlas-chat" aria-label="ATLAS SOFT satış danışmanı">
        <button type="button" id="atlasChatToggle" class="atlas-chat-toggle" aria-expanded="false" aria-controls="atlasChatPanel">✦ Yardımcı</button>
        <section id="atlasChatPanel" class="atlas-chat-panel" aria-label="Satış danışmanı sohbeti" hidden>
            <div class="atlas-chat-head">
                <div class="atlas-chat-identity">
                    <div class="atlas-chat-avatar" aria-hidden="true">✦</div>
                    <div class="atlas-chat-identity-text">
                        <strong>ATLAS AI Assistant</strong>
                        <small><span class="atlas-online-dot" aria-hidden="true"></span> Dijital Satış Danışmanı</small>
                    </div>
                </div>
                <button type="button" id="atlasChatClose" aria-label="Sohbeti kapat">×</button>
            </div>
            <div id="atlasChatMessages" class="atlas-chat-messages" role="log" aria-live="polite" aria-relevant="additions">
                <p class="atlas-chat-bot">👋 Merhaba! ATLAS SOFT'a hoş geldiniz. İşletmeniz için en uygun yazılımı birlikte keşfedelim. Size nasıl yardımcı olabilirim?</p>
            </div>
            <div class="atlas-chat-choices">
                <button type="button" data-atlas-question="ATLAS WMS nedir?">ATLAS WMS nedir?</button>
                <button type="button" data-atlas-question="Paket fiyatları nedir?">Paketler</button>
                <button type="button" data-atlas-question="Nasıl demo talep edebilirim?">Demo talebi</button>
                <button type="button" id="atlasChatReset" class="atlas-chat-reset">↻ Yeni Paket Hesapla</button>
                <a id="atlasChatDemo" class="atlas-chat-demo" asp-controller="Demo" asp-action="Index" hidden>Demo Talep Et →</a>
            </div>
            <form id="atlasChatForm" class="atlas-chat-form">
                <input id="atlasChatInput" type="text" maxlength="500" autocomplete="off" placeholder="Sorunuzu yazın..." aria-label="Mesajınız" required />
                <button type="submit" id="atlasChatSend">Gönder</button>
            </form>
            <p class="atlas-chat-note">✦ ATLAS SOFT — Akıllı Yazılım Çözümleri</p>
        </section>
    </div>
    <style>
        /* ATLAS SOFT - Premium AI Chat */
        .atlas-chat {
            position: fixed;
            right: 22px;
            bottom: 22px;
            z-index: 1100;
            font-family: 'Segoe UI',Arial,sans-serif;
        }

        .atlas-chat-toggle {
            position: relative;
            border: 1px solid rgba(255,255,255,.25);
            border-radius: 100px;
            background: linear-gradient(120deg,#0c4a9c,#267bea,#7057e8);
            background-size: 200% 200%;
            color: #fff;
            padding: 15px 23px;
            font-size: 14px;
            font-weight: 800;
            letter-spacing: .3px;
            box-shadow: 0 10px 35px rgba(38,133,237,.35),inset 0 1px 0 rgba(255,255,255,.25);
            animation: atlasGradient 7s ease infinite;
            transition: transform .25s,box-shadow .25s;
            cursor: pointer;
        }

            .atlas-chat-toggle:hover {
                transform: translateY(-4px);
                box-shadow: 0 15px 40px rgba(38,133,237,.5);
            }

        @@keyframes atlasGradient {
            0%, 100% {
                background-position: 0% 50%;
            }

            50% {
                background-position: 100% 50%;
            }
        }

        .atlas-chat-panel {
            position: absolute;
            right: 0;
            bottom: 76px;
            width: min(410px,calc(100vw - 24px));
            max-height: calc(100dvh - 110px);
            display: flex;
            flex-direction: column;
            overflow: hidden;
            border-radius: 24px;
            border: 1px solid rgba(112,171,255,.28);
            background: linear-gradient(155deg,#101e3a 0%,#0a1730 55%,#111b38 100%);
            color: #f8fafc;
            box-shadow: 0 30px 80px rgba(0,0,0,.5),0 0 35px rgba(45,120,255,.12),inset 0 1px 0 rgba(255,255,255,.08);
            opacity: 0;
            transform: translateY(24px) scale(.92);
            transform-origin: bottom right;
            pointer-events: none;
            transition: opacity .32s ease,transform .38s cubic-bezier(.2,.85,.25,1);
            will-change: opacity,transform;
        }

            .atlas-chat-panel.atlas-chat-open {
                opacity: 1;
                transform: translateY(0) scale(1);
                pointer-events: auto;
            }

            .atlas-chat-panel[hidden] {
                display: none !important;
            }

        .atlas-chat-head {
            display: flex;
            justify-content: space-between;
            align-items: center;
            flex-shrink: 0;
            padding: 20px;
            background: linear-gradient(115deg,rgba(29,77,145,.9),rgba(62,48,126,.75));
            border-bottom: 1px solid rgba(255,255,255,.12);
        }

        .atlas-chat-identity {
            display: flex;
            align-items: center;
            gap: 13px;
            min-width: 0;
        }

        .atlas-chat-avatar {
            width: 47px;
            height: 47px;
            flex-shrink: 0;
            display: flex;
            align-items: center;
            justify-content: center;
            border-radius: 15px;
            background: linear-gradient(135deg,#38bdf8,#6366f1);
            box-shadow: 0 0 22px rgba(56,189,248,.35);
            font-size: 28px;
            color: #fff;
        }

        .atlas-chat-identity-text {
            display: flex;
            flex-direction: column;
            gap: 5px;
            min-width: 0;
        }

            .atlas-chat-identity-text strong {
                color: #fff;
                font-size: 16px;
                font-weight: 800;
            }

            .atlas-chat-identity-text small {
                display: flex;
                align-items: center;
                gap: 7px;
                color: #c6d9f4;
                font-size: 11px;
            }

        .atlas-online-dot {
            width: 8px;
            height: 8px;
            border-radius: 50%;
            background: #34d399;
            box-shadow: 0 0 9px rgba(52,211,153,.7);
        }

        .atlas-chat-head > button {
            background: rgba(255,255,255,.1);
            color: #fff;
            border: 1px solid rgba(255,255,255,.15);
            border-radius: 10px;
            width: 35px;
            height: 35px;
            font-size: 24px;
            line-height: 1;
            cursor: pointer;
        }

        .atlas-chat-messages {
            flex: 1 1 auto;
            min-height: 100px;
            max-height: none;
            overflow-y: auto;
            padding: 22px 18px;
            display: flex;
            flex-direction: column;
            gap: 14px;
            scrollbar-width: thin;
            scrollbar-color: #345b8b transparent;
        }

        .atlas-chat-bot, .atlas-chat-user {
            max-width: 92%;
            padding: 14px 16px;
            font-size: 13px;
            line-height: 1.7;
            overflow-wrap: anywhere;
            margin: 0;
        }

        .atlas-chat-bot {
            align-self: flex-start;
            background: linear-gradient(135deg,#19395f,#173050);
            border: 1px solid rgba(106,162,233,.22);
            border-radius: 17px 17px 17px 5px;
            color: #eaf3ff;
            box-shadow: 0 5px 18px rgba(0,0,0,.1);
        }

        .atlas-chat-user {
            align-self: flex-end;
            background: linear-gradient(135deg,#267bea,#5458dd);
            border-radius: 17px 17px 5px 17px;
            color: #fff;
            box-shadow: 0 5px 18px rgba(38,133,237,.15);
        }

        .atlas-chat-choices {
            flex-shrink: 0;
            display: flex;
            flex-wrap: wrap;
            gap: 8px;
            padding: 12px 16px 16px;
        }

            .atlas-chat-choices button {
                border: 1px solid rgba(91,161,247,.35);
                background: rgba(34,91,157,.28);
                color: #dcecff;
                border-radius: 12px;
                padding: 10px 12px;
                font-size: 12px;
                font-weight: 600;
                transition: background .2s,transform .2s;
                cursor: pointer;
            }

                .atlas-chat-choices button:hover {
                    background: #267bea;
                    color: #fff;
                    transform: translateY(-2px);
                }

            .atlas-chat-choices .atlas-chat-reset {
                background: rgba(93,74,174,.2);
                border-color: rgba(153,137,255,.4);
            }

            .atlas-chat-choices .atlas-chat-demo {
                display: inline-flex;
                align-items: center;
                justify-content: center;
                border-radius: 12px;
                background: linear-gradient(135deg,#267bea,#5458dd);
                padding: 10px 13px;
                color: #fff;
                text-decoration: none;
                font-size: 13px;
                font-weight: 700;
            }

                .atlas-chat-choices .atlas-chat-demo[hidden] {
                    display: none !important;
                }

        .atlas-chat-form {
            flex-shrink: 0;
            display: flex;
            align-items: center;
            gap: 9px;
            padding: 14px 15px;
            background: rgba(8,20,42,.8);
            border-top: 1px solid rgba(255,255,255,.09);
        }

            .atlas-chat-form input {
                flex: 1;
                min-width: 0;
                border: 1px solid #37577d;
                border-radius: 13px;
                background: #f8fbff;
                color: #142b49;
                padding: 13px 12px;
                font-size: 13px;
                outline: none;
                transition: border-color .2s,box-shadow .2s;
            }

                .atlas-chat-form input:focus {
                    border-color: #38bdf8;
                    box-shadow: 0 0 0 3px rgba(56,189,248,.2);
                }

            .atlas-chat-form button {
                border: 0;
                border-radius: 13px;
                background: linear-gradient(135deg,#2685ed,#5558df);
                color: #fff;
                padding: 13px 15px;
                font-size: 13px;
                font-weight: 800;
                cursor: pointer;
            }

                .atlas-chat-form button:hover {
                    filter: brightness(1.12);
                }

                .atlas-chat-form button:disabled {
                    opacity: .55;
                    cursor: wait;
                }

        .atlas-chat-note {
            flex-shrink: 0;
            margin: 0;
            padding: 0 12px 15px;
            background: rgba(8,20,42,.8);
            text-align: center;
            color: #90a9cc;
            font-size: 10px;
            letter-spacing: .5px;
        }

        .atlas-chat button:focus-visible, .atlas-chat input:focus-visible {
            outline: 3px solid #7dd3fc;
            outline-offset: 2px;
        }

        @@media (max-width:480px) {
            .atlas-chat {
                right: 12px;
                bottom: 12px;
            }

            .atlas-chat-panel {
                width: calc(100vw - 24px);
                bottom: 70px;
                max-height: calc(100dvh - 95px);
                border-radius: 19px;
            }

            .atlas-chat-head {
                padding: 15px;
            }

            .atlas-chat-avatar {
                width: 40px;
                height: 40px;
            }

            .atlas-chat-identity-text strong {
                font-size: 14px;
            }

            .atlas-chat-messages {
                padding: 15px;
            }

            .atlas-chat-choices {
                padding: 9px 12px;
            }

            .atlas-chat-form {
                padding: 11px;
            }

            .atlas-chat-toggle {
                padding: 13px 18px;
            }
        }

        @@media (prefers-reduced-motion:reduce) {
            .atlas-chat-toggle {
                animation: none;
            }

            .atlas-chat-panel {
                transition: none;
            }
        }
    </style>
    <script>
        (() => {
            const toggle = document.getElementById('atlasChatToggle');
            const close = document.getElementById('atlasChatClose');
            const panel = document.getElementById('atlasChatPanel');
            const messages = document.getElementById('atlasChatMessages');
            const form = document.getElementById('atlasChatForm');
            const input = document.getElementById('atlasChatInput');
            const send = document.getElementById('atlasChatSend');
            const reset = document.getElementById('atlasChatReset');
            const demo = document.getElementById('atlasChatDemo');
            let closeTimer = null;
            let isChatOpen = false;
            const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
            const setOpen = open => {
                clearTimeout(closeTimer);
                isChatOpen = open;
                toggle.setAttribute('aria-expanded', String(open));
                if (open) {
                    panel.hidden = false;
                    // Kapalı başlangıç durumunun tarayıcıya uygulanmasını sağlar.
                    panel.classList.remove('atlas-chat-open');
                    void panel.offsetWidth;
                    panel.classList.add('atlas-chat-open');
                    input.focus({ preventScroll: true });
                } else {
                    panel.classList.remove('atlas-chat-open');
                    toggle.focus({ preventScroll: true });
                    if (reduceMotion.matches) {
                        panel.hidden = true;
                    } else {
                        closeTimer = setTimeout(() => {
                            if (!isChatOpen) panel.hidden = true;
                        }, 400);
                    }
                }
            };
            toggle.addEventListener('click', () => setOpen(!isChatOpen));
            close.addEventListener('click', () => setOpen(false));
            document.addEventListener('keydown', e => {
                if (e.key === 'Escape' && isChatOpen) setOpen(false);
            });
            function appendMessage(text, type) {
                const p = document.createElement('p');
                p.className = type === 'user' ? 'atlas-chat-user' : 'atlas-chat-bot';
                p.textContent = text;
                messages.appendChild(p);
                messages.scrollTop = messages.scrollHeight;
                return p;
            }
            async function ask(question) {
                if (!question || send.disabled) return;
                if (question.trim().toLocaleLowerCase('tr-TR') === 'yeni hesaplama') demo.hidden = true;
                appendMessage(question, 'user');
                input.value = '';
                send.disabled = true;
                input.disabled = true;
                const pending = appendMessage('Yanıt hazırlanıyor...', 'bot');
                try {
                    const response = await fetch('/api/sales-chat/ask', {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify({ message: question })
                    });
                    if (response.status === 429) throw new Error('Çok fazla mesaj gönderdiniz. Lütfen biraz bekleyin.');
                    if (!response.ok) throw new Error('Şu anda yanıt alınamadı. API bağlantısını kontrol edin.');
                    const data = await response.json();

        const replyText = typeof data.reply === 'string'
            ? data.reply
            : '';

        const packageNames = [
            'Kurumsal',
            'Profesyonel',
            'Başlangıç',
            'Business',
            'Mini'
        ];

        const recommendedPackage = packageNames.find(name =>
            replyText.toLocaleLowerCase('tr-TR')
                .includes(name.toLocaleLowerCase('tr-TR'))
        );

        if (recommendedPackage &&
            /paket/i.test(replyText) &&
            /uygun|değerlendirilmelidir/i.test(replyText)) {

            const depotMatch = question.match(
                /(\d+)\s*(?:adet\s+)?(?:depo|antrepo)/i
            );

            const userMatch = question.match(
                /(\d+)\s*(?:adet\s+)?(?:kullanıcı|personel|çalışan)/i
            );

            const params = new URLSearchParams();

            params.set('urun', 'ATLAS WMS');
            params.set('paket', recommendedPackage);

            if (depotMatch) {
                params.set('depo', depotMatch[1]);
            }

            if (userMatch) {
                params.set('kullanici', userMatch[1]);
            }

            const demoButton = document.getElementById('atlasChatDemo');

            if (demoButton) {
                demoButton.href = '/Demo?' + params.toString();
                demoButton.hidden = false;
            }
        }

                    pending.textContent = typeof data.reply === 'string' ? data.reply : 'Yanıt alınamadı.';
                    if (typeof data.reply === 'string' &&
                        (data.reply.includes('Paket uygun görünüyor') ||
                         data.reply.includes('Kurumsal Paket değerlendirilmelidir'))) {
                        demo.hidden = false;
                    }
                } catch (error) {
                    pending.textContent = error.message || 'Bağlantı hatası oluştu.';
                } finally {
                    send.disabled = false;
                    input.disabled = false;
                    input.focus();
                    messages.scrollTop = messages.scrollHeight;
                }
            }
            form.addEventListener('submit', e => {
                e.preventDefault();
                ask(input.value.trim());
            });
            reset.addEventListener('click', () => {
                ask('yeni hesaplama');
            });
            document.querySelectorAll('[data-atlas-question]').forEach(button => {
                button.addEventListener('click', () => ask(button.dataset.atlasQuestion));
            });
        })();
    </script>

    @await RenderSectionAsync("Scripts", required: false)


    <!-- ATLAS SOFT WhatsApp İletişim Butonu -->

