@{
    ViewData["Title"] = "ATLAS Business | Atlas Soft";
}

<div class="atlas-business-page">

    <section class="atlas-hero">
        <span class="atlas-label">ATLAS SOFT | İŞ YÖNETİMİ</span>

        <h1>ATLAS Business</h1>
        <h2>Akıllı Satın Alma ve Teklif Yönetimi</h2>

        <p>
            Satın alma taleplerini, tedarikçi tekliflerini
            ve fiyat karşılaştırmalarını tek platformda
            yönetmek için tasarlanan yeni çözümümüz.
        </p>

        

        <a href="#business-ozellikler" class="atlas-btn">
            Özellikleri Keşfet
        </a>

        <a asp-controller="Home"
           asp-action="Index"
           asp-fragment="iletisim"
           class="atlas-btn atlas-btn-outline">
            Bilgi Al
        </a>
    </section>

    <section class="atlas-section" id="business-ozellikler">

        <h2 class="atlas-heading">
            Satın Alma Sürecini Tek Merkezden Yönetin
        </h2>

        <p class="atlas-subtitle">
            Talep oluşturulmasından teklif değerlendirmesine
            kadar planladığımız modüller.
        </p>

        <div class="atlas-grid">

            <article class="atlas-card">
                <span class="atlas-label">TALEP</span>
                <h3>Satın Alma Talepleri</h3>
                <p>
                    Departmanların ihtiyaç duyduğu ürün
                    ve hizmetler için satın alma talepleri
                    oluşturulmasını ve takip edilmesini sağlayın.
                </p>
            </article>

            <article class="atlas-card">
                <span class="atlas-label">TEDARİKÇİ</span>
                <h3>Teklif Yönetimi</h3>
                <p>
                    Tedarikçilerden gelen fiyat tekliflerini,
                    teslim sürelerini ve ödeme koşullarını
                    düzenli biçimde karşılaştırın.
                </p>
            </article>

            <article class="atlas-card">
                <span class="atlas-label">ANALİZ</span>
                <h3>Teklif Karşılaştırma</h3>
                <p>
                    Farklı tedarikçilerden alınan teklifleri
                    fiyat, teslimat ve diğer kriterlere göre
                    değerlendirmeyi kolaylaştırın.
                </p>
            </article>

            <article class="atlas-card">
                <span class="atlas-label">YAPAY ZEKÂ</span>
                <h3>Akıllı Fiyat Araştırması</h3>
                <p>
                    Yapay zekâ desteğiyle ürün ve fiyat
                    araştırmalarını hızlandırmayı,
                    alternatifleri değerlendirmeyi
                    ve karar desteği sunmayı hedefliyoruz.
                </p>
                <p><strong>Planlanan özellik.</strong></p>
            </article>

            <article class="atlas-card">
                <span class="atlas-label">ONAY</span>
                <h3>Onay Süreçleri</h3>
                <p>
                    Satın alma taleplerinin yetkili kişiler
                    tarafından incelenmesi, onaylanması
                    veya revize edilmesi için iş akışları.
                </p>
            </article>

            <article class="atlas-card">
                <span class="atlas-label">RAPORLAMA</span>
                <h3>Satın Alma Raporları</h3>
                <p>
                    Tedarikçi, departman ve dönem bazlı
                    satın alma verilerinin analiz edilmesini
                    sağlayacak raporlama ekranları.
                </p>
            </article>

        </div>
    </section>

    <section class="atlas-section">
        <h2 class="atlas-heading">Planlanan İş Akışı</h2>

        <div class="atlas-grid">

            <div class="atlas-card">
                <h3>01 — Talep Oluştur</h3>
                <p>
                    İhtiyaç duyulan ürün veya hizmet için
                    satın alma talebi oluşturulur.
                </p>
            </div>

            <div class="atlas-card">
                <h3>02 — Teklifleri Karşılaştır</h3>
                <p>
                    Tedarikçi teklifleri toplanır,
                    fiyat ve koşullar değerlendirilir.
                </p>
            </div>

            <div class="atlas-card">
                <h3>03 — Onay ve Takip</h3>
                <p>
                    Uygun teklif onaya sunulur,
                    satın alma süreci takip edilir.
                </p>
            </div>

        </div>
    </section>

    <section class="atlas-contact">
        <h2 class="atlas-heading">
            ATLAS Business Hakkında Bilgi Alın
        </h2>

        <p>
            Geliştirmekte olduğumuz satın alma
            ve teklif yönetimi çözümü hakkında
            bilgi almak için bizimle iletişime geçin.
        </p>

        <a asp-controller="Home"
           asp-action="Index"
           asp-fragment="iletisim"
           class="atlas-btn">
            İletişime Geç
        </a>
    </section>

</div>
