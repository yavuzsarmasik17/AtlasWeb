@{
    ViewData["Title"] = "ATLAS AI | Atlas Soft";
}

<div class="atlas-ai-page">

    <section class="atlas-hero">
        <span class="atlas-label">ATLAS SOFT | YAPAY ZEKÂ</span>

        <h1>ATLAS AI</h1>

        <h2>Verilerinizi Akıllı İş Süreçlerine Dönüştürün</h2>

        <p>
            Belge okuma, operasyonel veri analizi ve
            doğal dille raporlama teknolojilerini
            tek platformda buluşturmayı hedefliyoruz.
        </p>

        <a href="#ai-ozellikler" class="atlas-btn">
            Özellikleri Keşfet
        </a>

        <a asp-controller="Home"
           asp-action="Index"
           asp-fragment="iletisim"
           class="atlas-btn atlas-btn-outline">
            Bilgi Al
        </a>
    </section>

    <section class="atlas-section" id="ai-ozellikler">

        <h2 class="atlas-heading">
            Yapay Zekâ Çözümlerimiz
        </h2>

        <p class="atlas-subtitle">
            Operasyonel verilerden daha hızlı ve
            anlamlı sonuçlar elde etmek için
            geliştirdiğimiz teknolojiler.
        </p>

        <div class="atlas-grid">

            <article class="atlas-card">
                <span class="atlas-label">BELGE İŞLEME</span>
                <h3>Akıllı Beyanname Okuma</h3>
                <p>
                    PDF veya görsel formatındaki antrepo
                    beyannamelerinden alanların otomatik
                    çıkarılması ve kullanıcı tarafından
                    doğrulanması.
                </p>
                <p><strong>Geliştirme ve test aşamasında.</strong></p>
            </article>

            <article class="atlas-card">
                <span class="atlas-label">VERİ ANALİZİ</span>
                <h3>Doğal Dille Sorgulama</h3>
                <p>
                    Karmaşık rapor ekranları arasında
                    dolaşmadan operasyon ve muhasebe
                    verilerine sorular sorulabilmesini
                    hedefleyen sorgulama altyapısı.
                </p>
                <p><strong>Geliştirme ve test aşamasında.</strong></p>
            </article>

            <article class="atlas-card">
                <span class="atlas-label">RAPORLAMA</span>
                <h3>Akıllı Raporlar</h3>
                <p>
                    Mal kabul, mal çıkış, stok ve cari hesap
                    hareketlerini daha anlaşılır raporlara
                    dönüştürmeye yönelik çalışmalar.
                </p>
                <p><strong>Geliştirme aşamasında.</strong></p>
            </article>

        </div>
    </section>

    <section class="atlas-section">
        <h2 class="atlas-heading">ATLAS AI ile Neler Hedefliyoruz?</h2>

        <div class="atlas-grid">

            <div class="atlas-card">
                <h3>Daha Az Manuel İşlem</h3>
                <p>
                    Belge üzerindeki bilgileri otomatik
                    okuyarak tekrar eden veri girişlerini
                    azaltmak.
                </p>
            </div>

            <div class="atlas-card">
                <h3>Daha Hızlı Bilgi Erişimi</h3>
                <p>
                    İşletme verilerine günlük konuşma
                    diliyle ulaşılabilmesini sağlamak.
                </p>
            </div>

            <div class="atlas-card">
                <h3>Kontrollü Otomasyon</h3>
                <p>
                    Yapay zekâ çıktılarının kullanıcı
                    tarafından doğrulanabildiği
                    güvenilir iş akışları geliştirmek.
                </p>
            </div>

        </div>
    </section>

    <section class="atlas-contact">
        <h2 class="atlas-heading">
            ATLAS AI Gelişmelerini Takip Edin
        </h2>

        <p>
            Yapay zekâ çözümlerimizin mevcut durumu
            ve geliştirme planları hakkında bilgi alın.
        </p>

        <a asp-controller="Home"
           asp-action="Index"
           asp-fragment="iletisim"
           class="atlas-btn">
            İletişime Geç
        </a>
    </section>

</div>
