@{
    ViewData["Title"] = "ATLAS | Akıllı Yazılım Çözümleri";
}

<style>
    .atlas-home {
        font-family: 'Segoe UI', Arial, sans-serif;
        color: #172b4d;
    }

    .atlas-hero {
        background: linear-gradient(120deg, #071c39, #14529b);
        color: white;
        border-radius: 20px;
        padding: 85px 35px;
        text-align: center;
        margin-top: 20px;
    }

        .atlas-hero h1 {
            font-size: clamp(36px, 5vw, 60px);
            font-weight: 800;
            letter-spacing: 3px;
        }

        .atlas-hero p {
            font-size: 18px;
            max-width: 750px;
            margin: 20px auto;
            color: #e0edff;
        }

    .atlas-btn {
        display: inline-block;
        background: #2685ed;
        color: white;
        text-decoration: none;
        border-radius: 9px;
        padding: 13px 24px;
        margin: 7px;
        font-weight: 600;
    }

        .atlas-btn:hover {
            background: #0869d4;
            color: white;
        }

    .atlas-btn-outline {
        background: transparent;
        border: 1px solid #c8dcff;
    }

    .atlas-section {
        padding: 65px 0 20px;
    }

    .atlas-heading {
        font-weight: 750;
        text-align: center;
        margin-bottom: 12px;
    }

    .atlas-subtitle {
        text-align: center;
        color: #64748b;
        max-width: 760px;
        margin: 0 auto 35px;
    }

    .atlas-grid {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 22px;
    }

    .atlas-card {
        background: white;
        border: 1px solid #e1e8f1;
        border-radius: 14px;
        padding: 27px;
        box-shadow: 0 5px 20px rgba(15, 35, 70, .05);
        height: 100%;
    }

        .atlas-card h3 {
            font-size: 21px;
            font-weight: 700;
            margin-bottom: 15px;
        }

        .atlas-card p, .atlas-card li {
            color: #58677e;
            line-height: 1.8;
        }

        .atlas-card ul {
            padding-left: 19px;
        }

    .atlas-price {
        font-size: 32px;
        font-weight: 800;
        color: #14529b;
        margin: 15px 0;
    }

        .atlas-price small {
            font-size: 14px;
            font-weight: 400;
            color: #64748b;
        }

    .atlas-label {
        display: inline-block;
        background: #eaf3ff;
        color: #14529b;
        border-radius: 20px;
        padding: 5px 12px;
        font-size: 12px;
        font-weight: 700;
        margin-bottom: 15px;
    }

    .atlas-contact {
        background: #f0f6ff;
        border-radius: 18px;
        padding: 45px 25px;
        text-align: center;
        margin: 60px 0;
    }

    @@media (max-width: 850px) {
        .atlas-grid {
            grid-template-columns: 1fr;
        }

        .atlas-hero {
            padding: 55px 20px;
        }
    }
</style>

<div class="atlas-home">

    <section class="atlas-hero">
        <span class="atlas-label">YAZILIM VE TEKNOLOJİ ÇÖZÜMLERİ</span>

        <h1>ATLAS</h1>

        <h2>İşletmenizin Dijital Gücü</h2>

        <p>
            Antrepo yönetimi, stok takibi, muhasebe,
            yapay zekâ destekli belge işleme ve iş süreçleri
            için geliştirdiğimiz yazılım çözümlerini keşfedin.
        </p>

        <a href="#urunler" class="atlas-btn">
            Yazılımlarımızı Keşfedin
        </a>

        <a asp-controller="Demo" asp-action="Index" class="atlas-btn atlas-btn-outline">
            Demo Talep Et
        </a>
    </section>


    <section class="atlas-product-showcase">

        <div class="atlas-showcase-content">

            <span class="atlas-showcase-label">
                ATLAS SOFT TEKNOLOJİLERİ
            </span>

            <h2>
                İşletmenizin Yönetimini
                <span>Tek Platformda Toplayın</span>
            </h2>

            <p>
                Atlas Soft ile antrepo operasyonlarını,
                stok hareketlerini, muhasebe süreçlerini
                ve iş takibini dijital ortamda yönetin.
            </p>

            <p>
                ATLAS WMS, operasyonel verilerinizi
                tek merkezden takip etmenizi sağlar.
                Yapay zekâ destekli belge okuma ve
                raporlama özellikleri ise geliştirme
                çalışmalarımızın önemli bir parçasıdır.
            </p>

            <a href="#urunler" class="atlas-btn">
                Çözümlerimizi İnceleyin
            </a>

        </div>

        <div class="atlas-showcase-visual">

            <div class="atlas-software-window">

                <div class="atlas-window-header">
                    <span></span>
                    <span></span>
                    <span></span>
                    <strong>ATLAS WMS</strong>
                </div>

                <div class="atlas-window-body">

                    <div class="atlas-window-title">
                        Operasyon Yönetim Paneli
                    </div>

                    <div class="atlas-mini-stats">
                        <div>
                            <small>Mal Kabul</small>
